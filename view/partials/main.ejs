<div class="explorer-container">
  <section class="current-path">
    <div>
      <span>Chemin courant : <%= currentPath %></span>
    </div>
  </section>

  <div>
    <span>Nom</span>
    <span>Type</span>
    <span>Date</span>
    <span>Taille</span>
  </div>

  <ul class="file-list">
    <% files.forEach(function(item) { %> <% if (item.isDirectory) { %>
    <li class="file-item">
      <a href="<%= item.path %>" class="folder-link">
        <span class="folder-icon">📁</span>
        <%= item.name %>
      </a>
    </li>
    <% } else { %>
    <li class="file-item">
      <span class="file-name">
        <span class="file-icon">📄</span>
        <%= item.name %>
      </span>
    </li>
    <% } %> <% }); %>
  </ul>
</div>
