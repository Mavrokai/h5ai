<div class="explorer-container">
  <section class="current-path">
    <div>
      <span>Chemin courant : <%= currentPath %></span>
    </div>
  </section>

  <table>
    <thead>
      <tr>
        <th>Type</th>
        <th>Nom</th>
        <th>Taille</th>
      </tr>
    </thead>
    <tbody>
      <% files.forEach(function(item) { %>
        <tr>
          <td class="icon-cell">
            <% if (item.isDirectory) { %>
              <a href="<%= item.path %>">📁</a>
            <% } else { %>
              <%
                const ext = item.extension;
                let icon = '📦'; // icône par défaut

                if (ext === '.txt') icon = '📝';
                else if (ext === '.pdf') icon = '📄';
                else if (['.jpg', '.jpeg', '.png', '.gif'].includes(ext)) icon = '🖼️';
                else if (['.mp4', '.mov', '.avi'].includes(ext)) icon = '🎬';
              %>
              <a href="<%= item.path %>"><%= icon %></a>
            <% } %>
          </td>
          <td class="name-cell">
            <a href="<%= item.path %>"><%= item.name %></a>
          </td>
          <td class="size-cell">
            <%= item.isDirectory ? '-' : (Math.round(item.size / 1024) + ' KB') %>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
